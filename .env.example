# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MAGISTERIUM_API_KEY: Optional API key from https://www.magisterium.com/developers
# Enables live responses from Magisterium AI (model: magisterium-1) with official
# citations from 28,000+ Catholic Church documents via server-side /api/magisterium.
MAGISTERIUM_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for the Nearby Mass,
# Confession & Adoration Finder and Interactive Stations of the Cross Jerusalem Map.
# Restrict this key by HTTP referrer and APIs in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=""

# GOOGLE_MAPS_PAUSED: Set to "true" to immediately pause all Google Maps Platform
# features site-wide (zero Maps/Places/Routes API calls) while preserving free fallbacks.
GOOGLE_MAPS_PAUSED="false"

# Optional safe monthly quota caps (app automatically stops Maps at 80% of these limits):
VITE_GMP_MONTHLY_MAP_LIMIT="800"
VITE_GMP_MONTHLY_PLACES_LIMIT="400"
VITE_GMP_MONTHLY_ROUTES_LIMIT="400"


