{"1":[{"verse":2,"note":"That is, Shalmaneser. Compare 2 Kings 17:3, 23."},{"verse":13,"note":"Gr. beauty."},{"verse":15,"note":"Gr. his highways were troubled."},{"verse":17,"note":"Some ancient authorities read behind."},{"verse":21,"note":"That is, Esar-haddon, and so in verse 22."}],"2":[{"verse":10,"note":"Some authorities read until he went."},{"verse":14,"note":"Gr. all things are known with you."}],"3":[{"verse":8,"note":"Gr. demon."},{"verse":10,"note":"Gr. Hades."},{"verse":17,"note":"Gr. demon."}],"4":[{"verse":17,"note":"Or, tomb"}],"6":[{"verse":16,"note":"Gr. if."}],"7":[{"verse":18,"note":"Many ancient authorities read joy."}],"10":[{"verse":2,"note":"Many ancient authorities read “Are they perchance put to shame?”"},{"verse":5,"note":"Some authorities read “Woe is me.”"}],"13":[{"verse":2,"note":"Gr. Hades."}]}