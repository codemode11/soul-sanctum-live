{"1":[{"verse":1,"note":"Gr. in goodness."},{"verse":6,"note":"Some authorities read the spirit of wisdom is loving to man."},{"verse":6,"note":"Or, reviler"},{"verse":7,"note":"Gr. the inhabited earth."},{"verse":14,"note":"Or, a royal house"},{"verse":16,"note":"Or, were consumed with love of him"}],"2":[{"verse":1,"note":"Or, among"},{"verse":1,"note":"Or, returned out of Hades"},{"verse":4,"note":"Gr. weighed down."},{"verse":5,"note":"Or, comes again"}],"5":[{"verse":7,"note":"See Proverbs 14:14."},{"verse":14,"note":"Gr. like foam chased to thinness: or, as thin foam chased."},{"verse":14,"note":"Most Greek authorities read hoar frost: some authorities, perhaps rightly, a spider’s web."}],"6":[{"verse":2,"note":"Or, in the multitudes of your nations"}],"7":[{"verse":1,"note":"Many authorities read a mortal man."},{"verse":20,"note":"Or, spirits"}],"8":[{"verse":6,"note":"Gr. she."},{"verse":7,"note":"Gr. her labors"}],"9":[{"verse":4,"note":"Or, children"},{"verse":8,"note":"Or, a place of sacrifice"},{"verse":12,"note":"Gr. thrones."}],"10":[{"verse":1,"note":"Gr. She."},{"verse":5,"note":"Gr. she"},{"verse":6,"note":"Gr. she"},{"verse":10,"note":"Gr. she."},{"verse":13,"note":"Gr. she."},{"verse":15,"note":"Gr. she."}],"11":[{"verse":4,"note":"See Deuteronomy 8:15; Psalms 114:8."}],"12":[{"verse":7,"note":"Or, children"},{"verse":8,"note":"Or, wasps"},{"verse":20,"note":"Or, children"},{"verse":24,"note":"Gr. living creatures: and so elsewhere in this book."}],"13":[{"verse":5,"note":"Gr. is the first maker of them seen."},{"verse":11,"note":"Gr. carpenter who is a woodcutter."}],"14":[{"verse":6,"note":"The Greek text here may be corrupt."}],"15":[{"verse":3,"note":"Gr. entire."},{"verse":5,"note":"Some authorities read reproach."},{"verse":8,"note":"Or, life"},{"verse":9,"note":"Or, copper"},{"verse":11,"note":"Gr. a soul that moves to activity."},{"verse":11,"note":"Or, life"},{"verse":12,"note":"Some authorities read they accounted."},{"verse":12,"note":"Or, way of life"}]}